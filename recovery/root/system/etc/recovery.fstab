odm                     /odm            erofs  ro                                         wait,slotselect,logical

/dev/block/by-name/metadata     /metadata      f2fs  noatime,nosuid,nodev,discard,inline_xattr                    wait,check,formattable
/dev/block/by-name/metadata     /metadata      ext4  noatime,nosuid,nodev                                         wait,check,formattable
